// Tablas de FlightManager. Los nombres de tabla (@@map) son los que pidió la materia.
// Aeropuertos: catálogo de Argentina. Vuelos: los del parser o cargados a mano. Programación: tipo de cada día.
// Plan de vuelo: una fila por tramo de la hoja de libro. Los nombres de campo son los mismos keys de logbook-form.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Aeropuerto {
  id                  Int         @id @default(autoincrement())
  iata                String      @unique
  icao                String      @unique
  name                String
  latitude            Float
  longitude           Float
  vuelosOrigen        Vuelo[]     @relation("origen")
  vuelosDestino       Vuelo[]     @relation("destino")
  @@map("aeropuertos")
}

model Vuelo {
  id            Int         @id @default(autoincrement())
  number        String
  date          DateTime
  originId      Int
  destinationId Int
  origin        Aeropuerto  @relation("origen", fields: [originId], references: [id])
  destination   Aeropuerto  @relation("destino", fields: [destinationId], references: [id])
  dep           String
  arr           String
  duration      String
  aircraft      String?
  crew          String?

  // El mismo numero de vuelo puede repetirse en otro dia: la clave es numero + fecha
  @@unique([number, date])
  @@map("vuelos")
}

// Tipo de actividad de cada dia: vuelo, deadhead, reserva, franco o sin_asignar.
// Va aparte de vuelos para no tener campos vacios en los dias sin vuelo.
model Programacion {
  id   Int      @id @default(autoincrement())
  date DateTime @unique
  type String

  @@map("programacion")
}

model PlanDeVuelo {
  id                      Int       @id @default(autoincrement())
  // Vuelo de la programación al que pertenece la hoja (número + fecha, igual que en vuelos)
  number                  String
  // Día, mes y año de la hoja, unidos en una fecha
  fecha                   DateTime
  horaSalida              String
  desde                   String
  hasta                   String
  horaLlegada             String
  finalidadVuelo          String
  marca                   String
  matricula               String
  potencia                Int
  clase                   String
  // Tiempos en horas decimales (1h 30m = 1.5)
  sobreDiaPiloto          Float?
  sobreDiaCopiloto        Float?
  sobreNochePiloto        Float?
  sobreNocheCopiloto      Float?
  travesiaDiaPiloto       Float?
  travesiaDiaCopiloto     Float?
  travesiaNochePiloto     Float?
  travesiaNocheCopiloto   Float?
  navegadorMecanico       Int?
  aterrizajes             Int?
  instruccion             Float?
  multimotor              Float?
  reactor                 Float?
  turbohelice             Float?
  adiestradorTerrestre    Float?
  instrumentoRealPiloto   Float?
  instrumentoRealCopiloto Float?
  instrumentoCapota       Float?
  // Firma del titular como PNG en base64 (data URL). Sin firma la hoja queda incompleta, pero se puede guardar
  firma                   String?

  @@unique([number, fecha])
  @@map("plan_de_vuelo")
}
